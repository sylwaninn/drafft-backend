#!/bin/sh
# Refuses pushes to main (.agents/rules/commits.md): work on a branch and open a pull request.
while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "pre-push: pushing to main is forbidden. Push a branch and open a pull request." >&2
    exit 1
  fi
done
exit 0
