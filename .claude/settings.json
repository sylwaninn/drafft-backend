{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.production)",
      "Read(**/.env.staging)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.dev.vars)",
      "Read(**/.dev.vars.*.local)",
      "Read(~/Secrets/**)",
      "Edit(**/.env)",
      "Edit(**/.env.production)",
      "Edit(**/.env.staging)",
      "Edit(**/.env.local)",
      "Edit(**/.dev.vars)",
      "Write(**/.env)",
      "Write(**/.env.production)",
      "Write(**/.env.staging)",
      "Write(**/.env.local)",
      "Write(**/.dev.vars)",
      "Bash(cat *.env*)",
      "Bash(head *.env*)",
      "Bash(tail *.env*)",
      "Bash(less *.env*)",
      "Bash(more *.env*)",
      "Bash(grep *.env*)",
      "Bash(rg *.env*)",
      "Bash(sed *.env*)",
      "Bash(awk *.env*)",
      "Bash(open *.env*)",
      "Bash(base64 *.env*)",
      "Bash(xxd *.env*)",
      "Bash(strings *.env*)",
      "Bash(cp *.env.production*)",
      "Bash(cp *.env.staging*)",
      "Bash(cat *.dev.vars*)",
      "Bash(grep *.dev.vars*)",
      "Bash(cat *Secrets/*)",
      "Read(~/.sentryclirc)",
      "Read(**/sentry.env)",
      "Read(**/.sentryclirc)",
      "Edit(~/Secrets/**)",
      "Write(~/Secrets/**)",
      "Edit(~/.sentryclirc)",
      "Write(~/.sentryclirc)",
      "Bash(cat *sentryclirc*)",
      "Bash(head *sentryclirc*)",
      "Bash(tail *sentryclirc*)",
      "Bash(grep *sentryclirc*)",
      "Bash(sed *sentryclirc*)",
      "Bash(awk *sentryclirc*)",
      "Bash(less *sentryclirc*)",
      "Bash(open *sentryclirc*)",
      "Bash(*sentry.env*)",
      "Bash(*Secrets/*)",
      "Bash(source *Secrets*)",
      "Bash(. *Secrets*)",
      "Bash(printenv*)",
      "Bash(env)",
      "Bash(echo *SENTRY_AUTH_TOKEN*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "git -C \"$CLAUDE_PROJECT_DIR\" config core.hooksPath .agents/git-hooks",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-git.py\"",
            "timeout": 10,
            "statusMessage": "Checking git safety rules"
          }
        ]
      }
    ]
  }
}
