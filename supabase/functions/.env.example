# Local functions: scripts/local-env.sh writes supabase/functions/.env.local (git-ignored) from .env.staging;
# fully offline, copy this file there instead (README, Local development).
# Hosted: `supabase secrets set --project-ref <ref> --env-file supabase/functions/.env.<env>` (refs in
# scripts/deploy.sh), never without --project-ref, or `scripts/deploy.sh <env> --secrets`.

# Must equal the `db_events_secret` Vault secret (see supabase/seed.sql).
DB_EVENTS_SECRET=local-dev-db-events-secret

# Stream Chat (dashboard → app → API keys). Pick the EU region when creating the app.
STREAM_API_KEY=
STREAM_API_SECRET=

# RevenueCat webhook: the exact Authorization header value set in the webhook's settings.
REVENUECAT_WEBHOOK_AUTH=

# Cloudflare R2 (S3 API token scoped to the bucket) and the public CDN domain serving it.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=drafft-media
MEDIA_PUBLIC_URL=https://media.getdrafft.com

# APNs token auth (.p8). Leave APNS_KEY_ID empty to skip pushes locally.
APNS_KEY_ID=
APNS_TEAM_ID=4F4J2C4L9W
APNS_BUNDLE_ID=so.drafft.app
# The .p8 content on one line, newlines as \n.
APNS_PRIVATE_KEY=

# FCM (Android pushes, HTTP v1): the service account key of the environment's Firebase project (the one the
# Android app's google-services.json belongs to), the whole JSON on one line. Leave empty to skip Android
# pushes locally.
FCM_SERVICE_ACCOUNT=

# AWS Rekognition (IAM user limited to rekognition:DetectModerationLabels and rekognition:DetectFaces). When
# set, it decides: approved, rejected, or left pending for review, and whether a photo shows a face (only a
# photo with one may be the portrait). Without DetectFaces the face stays unknown and doesn't block.
AWS_REKOGNITION_ACCESS_KEY_ID=
AWS_REKOGNITION_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-1

# Apple DeviceCheck (device-check, db-events): a key with DeviceCheck enabled, the team from APNS_TEAM_ID.
# Leave the key empty to skip Apple locally. DEVICECHECK_ENVIRONMENT is Apple's environment for this project,
# `production` or `development` (the app's own value is only logged): `production` when unset on a hosted
# project, `development` locally. Set it in both hosted projects (the drift check wants the same names).
DEVICECHECK_KEY_ID=
DEVICECHECK_PRIVATE_KEY=
DEVICECHECK_ENVIRONMENT=

# Auth emails (auth-email, Supabase Auth's Send Email hook). Hosted: the secret Auth > Hooks > Send Email
# generates, a Resend API key per environment, and a sender on a Resend-verified domain. Locally: the values
# below, and MAILPIT_URL sends to the local Mailpit (http://127.0.0.1:55424) instead of Resend.
SEND_EMAIL_HOOK_SECRET=v1,whsec_bG9jYWwtZGV2LXNlbmQtZW1haWwtaG9vay1zZWNyZXQ=
RESEND_API_KEY=
EMAIL_FROM=drafft <no-reply@mail.getdrafft.com>
MAILPIT_URL=http://host.docker.internal:55424
# Verification SMS (auth-sms, Supabase Auth's Send SMS hook). Hosted: the secret Auth > Hooks > Send SMS
# generates, and Twilio: the Account SID, an API key (SK…, its secret shown once) and a Messaging Service
# (sender "drafft", geo permissions limited to the app's countries). Locally: MAILPIT_URL shows the SMS in
# Mailpit instead, and the Twilio values stay empty.
SEND_SMS_HOOK_SECRET=v1,whsec_bG9jYWwtZGV2LXNlbmQtc21zLWhvb2stc2VjcmV0
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_MESSAGING_SERVICE_SID=
# The region of the API key and Messaging Service: ie1 (Ireland, the default when empty), us1 or au1.
TWILIO_REGION=

# Cloudflare Turnstile (support form sent signed out): the widget's secret key (dashboard → Turnstile), set in
# both hosted projects (unset there, signed-out support requests are refused). Locally: Cloudflare's public test
# secret below, which always passes; left empty, the check is skipped with a warning.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Support by email (support-inbound): the shared secret the support mail Worker sends (its own secret of the same
# name, per environment), and the address support emails carry as Reply-To (Cloudflare Email Routing hands its
# mail to that Worker). SUPPORT_ADDRESS unset: Reply-To stays SUPPORT_INBOX, the team's mailbox.
SUPPORT_INBOUND_SECRET=local-dev-support-inbound-secret
SUPPORT_ADDRESS=

# Local only: where a phone opens the links in auth emails (SUPABASE_URL is Docker-internal here).
AUTH_PUBLIC_URL=http://127.0.0.1:55421

# auto_approve: local development only, when Rekognition isn't configured. Never in production.
MODERATION_MODE=auto_approve
